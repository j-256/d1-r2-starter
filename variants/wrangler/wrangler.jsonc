{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "d1-r2-starter",
  "main": "src/worker.ts",
  // Set to the date this template was generated; bump when adopting new runtime features.
  "compatibility_date": "2026-08-10",
  // nodejs_compat is required: runtime/storage-context.ts uses node:async_hooks.
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "public"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "d1-r2-starter",
      // Replace with the id printed by `wrangler d1 create d1-r2-starter`.
      "database_id": "REPLACE_WITH_D1_DATABASE_ID",
      // Drizzle writes flat drizzle/NNNN_name.sql files; point Wrangler there.
      "migrations_dir": "drizzle"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "d1-r2-starter"
    }
  ]
}
